        Me.GestionaGrid(e)
    End Sub

    Private Sub DtpFecha_ValueChanged(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles DtpFecha.ValueChanged
        If Me.DtpFecha.Value > Now Then
            Me.DtpFecha.Value = Now
        Else
            Me.Consultar()
        End If
    End Sub

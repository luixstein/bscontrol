    Public Sub New(ByVal folioDescuento As String)
        Me.New()
        Me._FOLIO_DESCUENTO = folioDescuento

        Try
            If Me.Consultar = True Then
                Me._Existe = True
            End If
        Catch ex As Exception
            HandleError(Me.Nombre_Clase, "New", ex)
        End Try
    End Sub


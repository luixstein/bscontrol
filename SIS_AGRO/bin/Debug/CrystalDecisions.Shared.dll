        f.sQl = "SELECT CODIGO_CHOFER, NOMBRE_CHOFER FROM CAT_CHOFERES WHERE 1=1 AND  CODIGO_PLAZA=" & Usuario.Codigo_Plaza.ToString & " AND"
        f.Inicia("")

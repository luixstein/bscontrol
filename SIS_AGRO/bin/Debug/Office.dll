        Dim Sql As String
        'If Modulo = "" Then
        ' Sql = "SELECT DISTINCT CODIGO_DOCUMENTO,NOMBRE_TIPO_DOCUMENTO FROM VW_CAT_REL_DOCUMENTOS_USUARIOS WHERE ID_PLAZA=" & IdPLAZA & " and CODIGO_USUARIO=" & Usuario.Codigo_Usuario & " and " & Condicion

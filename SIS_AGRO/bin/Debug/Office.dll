IntCol = Me.Grid.col
Me.Text2.Text = Empty + Me.Grid.Text
Me.Text2.Visible = False
If IntCol = iGyGridPolizaNombreCuenta Then
    If Me.Grid.TextMatrix(IntRow, iGyGridPolizaCCON) = "-" Then
        IntCol = iGyGridPolizaReferencia
    End If
End If


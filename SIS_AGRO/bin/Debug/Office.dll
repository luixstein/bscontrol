    ConsultaPolizaAdmin Me.lblPolizaAdmin.Caption, Me.lblEjercicioAdmin.Caption
End Sub

Private Sub Text2_KeyDown(KeyCode As Integer, Shift As Integer)
    Call keydown_conta(KeyCode)
    Totaliza
End Sub

Private Sub Grid_EnterCell()

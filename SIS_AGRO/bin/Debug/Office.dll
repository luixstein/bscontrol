"CODIGO_MERCADO")
                    Me._TIMBRA_DOCUMENTO = CBool(dReader("TIMBRA_DOCUMENTO"))

                    bResultado = True
                End If
                dReader.Close()
            Catch ex As Exception
                HandleError(Me.Nombre_Catalogo, "ConsultarTipoDocumento", ex)
            Finally
                Me._Conexion.Close()
                cmd.Dispose()
            End Try
        End With

        Return bResultado
    End Function


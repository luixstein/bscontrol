</root>␀␀␀␀␀sRutaPDF = sReplace(Me.GridVerXML.TextMatrix(Me.GridVerXML.row, iGyGridVerXMLRutaPDF))
sRutaXML = sReplace(Me.GridVerXML.TextMatrix(Me.GridVerXML.row, iGyGridVerXMLRutaXML))

If txtLEN(sUUID) = False Then
    MsgBox "Debe de seleccionar un registro.", vbExclamation, Me.Caption
    Exit Function
End If

'If sTipoDocumento <> "ABACOSQL_POLIZAS" Then
'    MsgBox "De momento desde esta pantalla sÛlo se pueden ver XML y PDF de polizas directas.", vbExclamation, Me.Caption
'    Exit Function
'End If

Me.Enabled = False
If (txtLEN(sRutaPDF) = True) And (sTipoComando = "VER_PDF") Then 'Llama al PDF mediante la ruta
    AbrirArchivo sRutaPDF
ElseIf (txtLEN(sRutaXML) = True) And (sTipoComando = "VER_XML") Then 'Llama al XML mediante la ruta
    AbrirArchivo sRutaXML
Else 'Llama al PDF/XML de Expedientes
    If sModoWebAPP_2 = "1" Then
        sRutaExeAbaconet = sCarpetaUsuario & "\AbacoNet.exe"
    Else
        sRutaExeAbaconet = "C:\Abacosql\AbacoNet\AbacoNet.exe"
    End If

    If ActualizarAbaconet(sRutaExeAbaconet) = False Then
        Exit Function
    End If
    
    Dim shell As WshShell
    Dim lngReturnCode As Long
    Dim strShellCommand As String
    Set shell = New WshShell

    sComando = sRutaExeAbaconet & _
    " VER_XML_PDF_POLIZAS" & _
    "," & sServer & _
    "," & sData & _
    "," & sUUID & _
    "," & sTipoComando
    
    lngReturnCode = shell.Run(sComando, vbNormalFocus, vbTrue)
End If
Me.Enabled = True
VerXMLPDF_Polizas = True

Exit Function
err_C:
    Me.Enabled = True
    HandleError Me.Name, "VerXMLPDF_Polizas", err.Number, err.Description
End Function

Private Function GestionaBotonesVerXMLPDF(ByVal sTipoComando As String) As Boolean
    On Error GoTo err_C
Dim sTipoDocumento As String
sTipoDocumento = sReplace(Me.GridVerXML.TextMatrix(Me.GridVerXML.row, iGyGridVerXMLTipoDocumento))

If sTipoDocumento = "COMPRA" Then
    VerXMLPDF_COMPRAS sTipoComando   'VER_XML o VER_PDF
Else 'Si es ABACOSQL_POLIZAS u otro tipo
    VerXMLPDF_Polizas Ôªø<?xml version="1.0" encoding="utf-8"?>

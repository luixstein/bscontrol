    On Error GoTo err_C
Dim dExistenciaFaltante As Double, IndexRow As Integer, sArticulo As String

For IndexRow = 2 To Me.Grid.rows - 1
    sArticulo = (Empty & Grid.TextMatrix(IndexRow, iGyCodigo))
    If Len(sArticulo) > 0 Then
        Grid.TextMatrix(IndexRow, iGyExistenciaCEDIS) = Format(FindObtieneExistencia(sArticulo, Me.txtAlmacenCEDIS.Text), "###,###,##0." & empresa.SFormatCant)
        
        dExistenciaFaltante = valorNumerico(Grid.TextMatrix(IndexRow, iGyCantidad)) - valorNumerico(Grid.TextMatrix(IndexRow, iGyExistenciaCEDIS))
        
        If dExistenciaFaltante <= 0 Then
            dExistenciaFaltante = 0
        End If
        
        Me.Grid.TextMatrix(IndexRow, iGyExistenciaFaltante) = Format(dExistenciaFaltante, "###,###,##0." & empresa.SFormatCant)
        ColoreaCelda dExistenciaFaltante, IndexRow, Me.Grid.col
    End If
Next

ActualizaExistenciasFaltantes = True
Exit Function
err_C:
    HandleError Me.Name, "ActualizaExistenciasFaltantes", err.Number, err.Description
End Function

Private Function AgregaDireccionEntrega() As Boolean
    On Error GoTo err_C
Dim Direcciones As frmDireccionesEntrega

If isExisteAlmacen(Me.txtAlmacenPedido.Text) = False Then
    MsgBox "El almacÈn destino no existe.", vbExclamation, Me.Caption
    Me.txtAlmacenPedido.SetFocus
    Exit Function
End If
    
Set Direcciones = New frmDireccionesEntrega

Direcciones.sCod_alm = Me.txtAlmacenPedido.Text

Direcciones.Show vbModal


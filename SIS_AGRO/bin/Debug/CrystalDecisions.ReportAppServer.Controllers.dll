@MOTIVO_CANCELACION NVARCHAR(100)='',    
@MODULO NVARCHAR(20),
@COD_USU_PREAUTORIZO_CANCELACION NVARCHAR(2)=NULL)      
      
AS      
DECLARE @HORA_SISTEMA DATETIME=GETDATE()      
SET NOCOUNT ON        
      
DECLARE @STORE_PROCEDURE_NAME NVARCHAR(255)='MP_ACTUALIZA_MOTIVO_CANCELACION'        
      
BEGIN TRANSACTION      
      
IF @MODULO='F'   
BEGIN--'FACTURACION'    
 UPDATE FACGLOB SET CODIGO_MOTIVO_CANCELACION=@CODIGO_MOTIVO,MOTIVO_CANCELACION=@MOTIVO_CANCELACION,
 COD_USU_PREAUTORIZO_CANCELACION=@COD_USU_PREAUTORIZO_CANCELACION
 WHERE FOLIO=@FOLIO      
    
 IF @@ERROR<>0    
 BEGIN    
  RAISERROR('ERROR AL INTENTAR ACTUALIZAR EL MOTIVO DE LA CANCELACION EN FACTURACION. %s',16,1,@STORE_PROCEDURE_NAME)    
  GOTO ROLL    
 END    
END 

ELSE IF @MODULO='P'  
BEGIN--'COMPRAS'    
 UPDATE COMPGLOB SET CODIGO_MOTIVO_CANCELACION=@CODIGO_MOTIVO,MOTIVO_CANCELACION=@MOTIVO_CANCELACION WHERE FOLIO=@FOLIO      
     
 IF @@ERROR<>0    
 BEGIN    
  RAISERROR('ERROR AL INTENTAR ACTUALIZAR EL MOTIVO DE LA CANCELACION EN COMPRAS. %s',16,1,@STORE_PROCEDURE_NAME)    
  GOTO ROLL    
 END    
END  

ELSE IF @MODULO='V'  
BEGIN--'DEVOLUCIONES DE VENTA'    
 UPDATE FACDEVG SET CODIGO_MOTIVO_CANCELACION=@CODIGO_MOTIVO,MOTIVO_CANCELACION=@MOTIVO_CANCELACION WHERE FOLIO=@FOLIO      
     
 IF @@ERROR<>0    
 BEGIN    
  RAISERROR('ERROR AL INTENTAR ACTUALIZAR EL MOTIVO DE LA CANCELACION EN DEVOLUCIONES DE VENTAS. %s',16,1,@STORE_PROCEDURE_NAME)    
  GOTO ROLL    
 END    
END  

ELSE IF @MODULO='I'  
BEGIN--'MOVIMIENTOS DE INVENTARIOS'    
 UPDATE INVORDG SET CODIGO_MOTIVO_CANCELACION=@CODIGO_MOTIVO,MOTIVO_CANCELACION=@MOTIVO_CANCELACION WHERE FOLIO=@FOLIO      
     
 IF @@ERROR<>0    
 BEGIN    
  RAISERROR('ERROR AL INTENTAR ACTUALIZAR EL MOTIVO DE LA CANCELACION EN LOS MOVIMIENTOS DE INVENTARIOS. %s',16,1,@STORE_PROCEDURE_NAME)    
  GOTO ROLL    
 END    
END

ELSE IF @MODULO='B'  
BEGIN--'BANCOS'    
 UPDATE BANGLOB SET CODIGO_MOTIVO_CANCELACION=@CODIGO_MOTIVO,MOTIVO_CANCELACION=@MOTIVO_CANCELACION WHERE FOLIO=@FOLIO      
     
 IF @@ERROR<>0    
 BEGIN    
  RAISERROR('ERROR AL INTENTAR ACTUALIZAR EL MOTIVO DE LA CANCELACION EN BANCOS. %s',16,1,@STORE_PROCEDURE_NAME)    
  GOTO ROLL    
 END    
END

ELSE IF @MODULO='C'  
BEGIN--'BANCOS'    
 UPDATE CXC_DESCUENTOS_GLOBAL SET CODIGO_MOTIVO_CANCELACION=@CODIGO_MOTIVO,MOTIVO_CANCELACION=@MOTIVO_CANCELACION WHERE FOLIO_DESCUENTO=@FOLIO      
     
 IF @@ERROR<>0    
 BEGIN    
  RAISERROR('ERROR AL INTENTAR ACTUALIZAR EL MOTIVO DE LA CANCELACION EN CXC DESCUENTOS. %s',16,1,@STORE_PROCEDURE_NAME)    
  GOTO ROLL    
 END    
END  
  
IF @@ERROR<>0      
BEGIN      
ROLL:      
 ROLLBACK TRANSACTION      
 RETURN      
END      
      
COMMIT TRANSACTION      

INSERT SIS_LOG_DURACION SELECT GETDATE(),HOSTNAME,OBJECT_NAME(@@PROCID),DATEDIFF(MILLISECOND,@HORA_SISTEMA,GETDATE()) from master.dbo.sysprocesses where spid = @@SPID      
GO

GRANT EXEC ON DBO.MP_ACTUALIZA_MOTIVO_CANCELACION TO ABACO
GO

/*

EXEC MP_ACTUALIZA_MOTIVO_CANCELACION
@FOLIO='FSQ-4201',
@CODIGO_MOTIVO=0,      
@MOTIVO_CANCELACION='HABER',
@MODULO='F'
--@COD_USU_PREAUTORIZO_CANCELACION NVARCHAR(2)=NULL,
--@COD_USU_AUTORIZO_CANCELACION NVARCHAR(2)=NULL

SELECT TOP 5 * FROM FACGLOB ORDER BY IDFACTURA DESC

SELECT * FROM CAT_MOTIVOS_CANCELACION
*/␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀